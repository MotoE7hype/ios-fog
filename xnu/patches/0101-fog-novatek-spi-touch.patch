+static int
+fog_spi_xfer(const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr)
+{
+	vm_offset_t se = st.se;
+	if (st.dead || !se) return EIO;
+	if (!touch_wait_clear(se, SE_STATUS, 1u)) {
+		st.dead = true;
+		return EBUSY;
+	}
+	touch_wr(se, SE_GENI_M_IRQ_CLR_REG, 0xffffffffu);
+	unsigned words = nt >= nr ? (nt + 3u) / 4u : (nr + 3u) / 4u;
+	if (!words) words = 1;
+	touch_wr(se, SE_SPI_TX_TRANS_LEN, words);
+	touch_wr(se, SE_SPI_RX_TRANS_LEN, words);
+	uint32_t mcmd = 0;
+	if (nt) mcmd |= SPI_TX_ONLY;
+	if (nr) mcmd |= SPI_RX_ONLY;
+	if (!nt && nr) mcmd = SPI_RX_ONLY;
+	if (nt && nr) mcmd = SPI_TX_ONLY | SPI_RX_ONLY;
+	touch_wr(se, SE_GENI_M_CMD0, ((mcmd & 0xfu) << 27));
+	touch_wr(se, SE_GENI_TX_WATERMARK, 0);
+	unsigned sent = 0, got = 0;
+	for (unsigned i = 0; i < 5000; ++i) {
+		uint32_t irq = touch_rd(se, SE_GENI_M_IRQ_STATUS);
+		if (irq) {
+			touch_wr(se, SE_GENI_M_IRQ_CLR_REG, irq);
+			if (irq & (M_CMD_FAILURE_EN | M_CMD_OVERRUN_EN | M_ILLEGAL_CMD_EN)) {
+				touch_abort();
+				return EIO;
+			}
+		}
+		if (nt && sent < nt) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < 4 && sent + j < nt; ++j)
+				word |= (uint32_t)tx[sent + j] << (8u * j);
+			touch_wr(se, SE_GENI_TX_FIFOn, word);
+			sent += 4;
+		}
+		if (irq & M_RX_FIFO_WM_EN) {
+			uint32_t rstat = touch_rd(se, SE_GENI_RX_FIFO_STATUS);
+			uint32_t rc = rstat & 0x1ffffffu;
+			for (unsigned k = 0; k < rc; ++k) {
+				uint32_t word = touch_rd(se, SE_GENI_RX_FIFOn);
+				for (unsigned b = 0; b < 4 && rx; ++b) {
+					unsigned idx = got++;
+					if (idx < nr)
+						rx[idx] = (uint8_t)(word >> (8u * b));
+				}
+			}
+		}
+		if (irq & M_CMD_DONE_EN) {
+			break;
+		}
+		delay(1);
+	}
+	for (unsigned j = 0; j < 4096 && got < nr + 32 && rx; ++j) {
+		uint32_t rstat = touch_rd(se, SE_GENI_RX_FIFO_STATUS);
+		uint32_t rc = rstat & 0x1ffffffu;
+		if (!rc) break;
+		for (unsigned k = 0; k < rc; ++k) {
+			uint32_t word = touch_rd(se, SE_GENI_RX_FIFOn);
+			for (unsigned b = 0; b < 4; ++b) {
+				unsigned idx = got++;
+				if (idx < nr)
+					rx[idx] = (uint8_t)(word >> (8u * b));
+			}
+		}
+		delay(1);
+	}
+	if (touch_rd(se, SE_STATUS) & 1u) {
+		touch_abort();
+		return EIO;
+	}
+	return 0;
+}
