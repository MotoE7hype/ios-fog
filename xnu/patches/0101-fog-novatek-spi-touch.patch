+static void
+fog_gpio_init(void)
+{
+	vm_offset_t west = st.west;
+	vm_offset_t east = st.east;
+	if (west) {
+		/* IRQ input, pull up */
+		uint32_t off = TOUCH_GPIO_CFG(FOG_PIN_IRQ);
+		uint32_t cfg = touch_rd(west, off);
+		touch_wr(west, TOUCH_GPIO_IO(FOG_PIN_IRQ), touch_rd(west, TOUCH_GPIO_IO(FOG_PIN_IRQ)) & ~2u);
+		cfg &= ~0x3ffu;
+		cfg |= (0 << 2) | 3 | (3 << 6); /* in, pull up */
+		touch_wr(west, off, cfg);
+		/* reset low then high */
+		off = TOUCH_GPIO_CFG(FOG_PIN_RESET);
+		cfg = touch_rd(west, off);
+		touch_wr(west, TOUCH_GPIO_IO(FOG_PIN_RESET), touch_rd(west, TOUCH_GPIO_IO(FOG_PIN_RESET)) & ~2u);
+		cfg &= ~0x3ffu;
+		cfg |= (0 << 2) | 3 | (3 << 6) | 0x200u;
+		touch_wr(west, off, cfg);
+	}
+	if (east) {
+		uint32_t off = TOUCH_GPIO_CFG(FOG_PIN_AVDD);
+		uint32_t cfg = touch_rd(east, off);
+		touch_wr(east, TOUCH_GPIO_IO(FOG_PIN_AVDD), (touch_rd(east, TOUCH_GPIO_IO(FOG_PIN_AVDD)) & ~2u) | 2u);
+		cfg &= ~0x3ffu;
+		cfg |= (0 << 2) | 3 | (3 << 6) | 0x200u;
+		if (cfg & (1u << 11)) cfg |= 1u << 12;
+		touch_wr(east, off, cfg);
+	}
+}
