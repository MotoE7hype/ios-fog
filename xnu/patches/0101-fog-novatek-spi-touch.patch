+static bool
+fog_spi_init_se0(void)
+{
+	vm_offset_t se = st.se;
+	uint32_t fw = touch_rd(se, SE_FW);
+	printf("SWEET TOUCH: fog se0 fw=%#x proto=%u status=%#x\n", fw, (fw >> 8) & 0xffu, touch_rd(se, SE_STATUS));
+	if (((fw >> 8) & 0xffu) != 1u) {
+		/* try to proceed anyway */
+		printf("SWEET TOUCH: fog se0 proto!=1, attempting SPI init anyway\n");
+	}
+	touch_wr(se, 0x648, 0xffffffffu);
+	touch_wr(se, SE_GENI_M_IRQ_EN_REG, 0);
+	touch_wr(se, SE_GENI_M_IRQ_CLR_REG, 0xffffffffu);
+	touch_wr(se, SE_GENI_OUTPUT_CTRL, SE_GENI_IO_MUX_0_EN | 0x7e);
+	touch_wr(se, SE_DMA, 0);
+	touch_wr(se, SE_GENI_CFG_SEQ_START, 1);
+	touch_wait(1);
+	touch_wr(se, SE_GENI_CFG_SEQ_START, 0);
+	touch_wr(se, SE_GENI_CLK_SEL, 0);
+	touch_wr(se, SE_GENI_CLK_CTRL, (2u << 4) | 1u);
+	touch_wr(se, SE_SPI_TRANS_CFG, touch_rd(se, SE_SPI_TRANS_CFG) & ~BIT(1));
+	touch_wr(se, SE_SPI_CPHA, 0);
+	touch_wr(se, SE_SPI_CPOL, 0);
+	touch_wr(se, SE_GENI_CFG_REG, 0);
+	touch_wr(se, SE_GENI_TX_PACK0, SE_PACK0);
+	touch_wr(se, SE_GENI_TX_PACK1, SE_PACK1);
+	touch_wr(se, SE_GENI_RX_PACK0, SE_PACK0);
+	touch_wr(se, SE_GENI_RX_PACK1, SE_PACK1);
+	touch_wr(se, SE_SPI_WORD_LEN, 8 - 4);
+	touch_wr(se, SE_GENI_TX_WATERMARK, 1);
+	touch_wr(se, SE_GENI_RX_WATERMARK, 0);
+	touch_wr(se, SE_GENI_RX_RFR_WATERMARK, ((touch_rd(se, SE_HW_RX) >> 16) & 0x3fu) - 2u);
+	touch_wr(se, SE_SPI_DELAY, 0);
+	uint32_t irq = M_CMD_DONE_EN | M_CMD_FAILURE_EN | M_CMD_OVERRUN_EN | M_ILLEGAL_CMD_EN | M_CMD_CANCEL_EN | M_CMD_ABORT_EN | M_TX_FIFO_WR_ERR_EN | M_RX_FIFO_WR_ERR_EN | M_RX_FIFO_RD_ERR_EN;
+	touch_wr(se, SE_GENI_M_IRQ_EN_REG, irq);
+	return true;
+}
