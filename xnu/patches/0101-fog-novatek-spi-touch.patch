+static int
+nvt_set_page(uint32_t addr)
+{
+	uint8_t buf[3];
+	buf[0] = NVT_SPI_WRITE_MASK(NVT_PAGE_CMD);
+	buf[1] = (uint8_t)((addr >> 15) & 0xFF);
+	buf[2] = (uint8_t)((addr >> 7) & 0xFF);
+	uint8_t tmp[3];
+	return fog_spi_xfer(buf, 3, tmp, 0);
+}
+
+static int
+nvt_read(uint32_t addr, uint8_t *buf, unsigned len)
+{
+	if (!len) return 0;
+	uint32_t page = addr & ~0x7Fu;
+	if ((page != (addr + len - 1) & ~0x7Fu)) {
+		/* simple: handle one page */
+	}
+	int err = nvt_set_page(page);
+	if (err) return err;
+	uint8_t xbuf[64], rbuf[64];
+	memset(xbuf, 0, sizeof(xbuf));
+	xbuf[0] = NVT_SPI_READ_MASK((uint8_t)(addr & 0x7F));
+	for (unsigned i = 1; i < len + 1 + NVT_DUMMY_BYTES && i < sizeof(xbuf); ++i) xbuf[i] = 0;
+	err = fog_spi_xfer(xbuf, len + 1 + NVT_DUMMY_BYTES, rbuf, len + 1 + NVT_DUMMY_BYTES);
+	if (err) return err;
+	for (unsigned i = 0; i < len && i + 2 < sizeof(rbuf); ++i) buf[i] = rbuf[i + 2];
+	return 0;
+}
+
+static int
+nvt_write(uint32_t addr, const uint8_t *data, unsigned len)
+{
+	if (!len) return 0;
+	int err = nvt_set_page(addr & ~0x7Fu);
+	if (err) return err;
+	uint8_t xbuf[64];
+	memset(xbuf, 0, sizeof(xbuf));
+	xbuf[0] = NVT_SPI_WRITE_MASK((uint8_t)(addr & 0x7F));
+	for (unsigned i = 0; i < len && i + 1 < sizeof(xbuf); ++i) xbuf[1 + i] = data[i];
+	return fog_spi_xfer(xbuf, 1 + len, NULL, 0);
+}
+
+static int
+nvt_clear_fw_status(uint32_t buf_addr)
+{
+	uint8_t b[2];
+	for (int i = 0; i < 20; ++i) {
+		uint32_t a = buf_addr | NVT_EVENT_MAP_HANDSHAKING_or_SUB_CMD_BYTE;
+		/* use handshaking */
+		nvt_set_page(buf_addr & ~0x7Fu);
+		/* write handshaking */
+		uint8_t wb[2] = {NVT_SPI_WRITE_MASK((uint8_t)(0x51)), 0x00};
+		uint8_t rb[4];
+		fog_spi_xfer(wb, 2, NULL, 0);
+		uint8_t rb2[2] = {NVT_SPI_READ_MASK((uint8_t)0x51), 0};
+		if (!fog_spi_xfer(rb2, 3, rb, 3)) {
+			if (rb[2] == 0x00) return 0;
+		}
+		touch_wait(10);
+	}
+	return EIO;
+}
+
+#ifndef NVT_EVENT_MAP_HANDSHAKING_or_SUB_CMD_BYTE
+#define NVT_EVENT_MAP_HANDSHAKING_or_SUB_CMD_BYTE 0x51
+#endif
+
+static int
+nvt_read_report(uint32_t buf_addr, uint8_t *rbuf, unsigned len)
+{
+	int err = nvt_set_page(buf_addr & ~0x7Fu);
+	if (err) return err;
+	uint8_t xbuf[96], tmp[96];
+	memset(xbuf, 0, sizeof(xbuf));
+	memset(tmp, 0, sizeof(tmp));
+	xbuf[0] = NVT_SPI_READ_MASK((uint8_t)(buf_addr & 0x7F));
+	err = fog_spi_xfer(xbuf, len + 1 + NVT_DUMMY_BYTES, tmp, len + 1 + NVT_DUMMY_BYTES);
+	if (err) return err;
+	for (unsigned i = 0; i < len && i + 2 < sizeof(tmp); ++i)
+		rbuf[i] = tmp[i + 2];
+	return 0;
+}
