+/*
+ * fog: QUPv3 SE0 as a GENI SPI master in FIFO mode (no GSI, no DMA),
+ * driving the Novatek NVT-ts-spi controller. CS framing: CS_TOGGLE is
+ * cleared, so the sequencer drives CS around each primary command, and
+ * SPI_FRAGMENT keeps CS asserted between the two halves of a register read.
+ */
+static const uint32_t fog_nvt_pages[NVT_PAGE_COUNT] = {
+	0x21c00u,   /* NT36672A */
+	0x11a00u,   /* NT36525 */
+	0x22d00u,   /* NT36675 */
+	0x11e00u,   /* NT36772 */
+};
+static uint32_t fog_nvt_page = 0x21c00u;
+static unsigned fog_abs_x, fog_abs_y;
+
+/* Drain packed RX FIFO words into rx[]. Returns nonzero on a lost frame. */
+static int
+touch_fog_drain(uint8_t *rx, unsigned nr, unsigned *got)
+{
+	uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+
+	if (count > 64u) {
+		return EIO;
+	}
+	while (count-- && *got < nr) {
+		uint32_t word = touch_rd(st.se, SE_RX);
+		for (unsigned j = 0; j < 4u && *got < nr; ++j) {
+			rx[(*got)++] = (uint8_t)(word >> (8u * j));
+		}
+	}
+	return 0;
+}
+
+/* One-line SE snapshot, printed for the first few failed commands only. */
+static unsigned fog_dumps;
+
+static void
+touch_fog_dump(void)
+{
+	if (fog_dumps++ >= 4u) {
+		return;
+	}
+	printf("SWEET TOUCH: fog regs dma=%#x miren=%#x mirq=%#x status=%#x "
+	    "txst=%#x rxst=%#x txlen=%#x rxlen=%#x\n",
+	    touch_rd(st.se, SE_DMA), touch_rd(st.se, SE_IRQ_EN),
+	    touch_rd(st.se, SE_IRQ), touch_rd(st.se, SE_STATUS),
+	    touch_rd(st.se, SE_TX_COUNT), touch_rd(st.se, SE_RX_COUNT),
+	    touch_rd(st.se, SE_TX_LEN), touch_rd(st.se, SE_RX_LEN));
+	printf("SWEET TOUCH: fog regs rwm=%#x rfr=%#x ios=%#x cmd_err=%#x "
+	    "fw_err=%#x cfg=%#x word=%#x gran=%#x hw=%#x/%#x\n",
+	    touch_rd(st.se, SE_RX_WM), touch_rd(st.se, SE_RFR_WM),
+	    touch_rd(st.se, SE_IOS), touch_rd(st.se, SE_CMD_ERR),
+	    touch_rd(st.se, SE_FW_ERR), touch_rd(st.se, SE_SPI_TRANS_CFG),
+	    touch_rd(st.se, SE_SPI_WORD_LEN), touch_rd(st.se, SE_GENI_BYTE_GRAN),
+	    touch_rd(st.se, SE_HW_TX), touch_rd(st.se, SE_HW_RX));
+}
+
+/* Queue as many packed FIFO words of tx[] as the TX FIFO currently holds. */
+static void
+touch_fog_fill_tx(const uint8_t *tx, unsigned nt, unsigned *sent, unsigned depth)
+{
+	/* Never trust a parsed depth above 16 words for the fill guard; a bad
+	 * guess would overrun the real FIFO and wedge the command. */
+	if (depth > 16u) {
+		depth = 16u;
+	}
+	while (*sent * 4u < nt &&
+	    (touch_rd(st.se, SE_TX_COUNT) & 0xffffffu) + 2u < depth) {
+		unsigned base = *sent * 4u;
+		uint32_t word = 0;
+		for (unsigned j = 0; j < 4u && base + j < nt; ++j) {
+			word |= (uint32_t)tx[base + j] << (8u * j);
+		}
+		touch_wr(st.se, SE_TX, word);
+		(*sent)++;
+	}
+}
+
+/* One primary-sequencer FIFO command; lengths are in SPI words = bytes. */
+static unsigned fog_logs;
+
+static int
+touch_spi_run(unsigned opcode, unsigned params, const uint8_t *tx, unsigned nt,
+    uint8_t *rx, unsigned nr)
+{
+	unsigned words = (nt + 3u) / 4u, sent = 0, got = 0;
+	unsigned depth = st.fog_depth ? st.fog_depth : 16u;
+
+	if (st.dead || (!nt && !nr) || nt > 96 || nr > 96) {
+		return EINVAL;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE0 owner is supported */
+		return EBUSY;
+	}
+	st.irq_status = st.irq_last = 0;
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_TX_WM, 0);
+	if (nt) {
+		touch_wr(st.se, SE_TX_LEN, nt);
+	}
+	if (nr) {
+		touch_wr(st.se, SE_RX_LEN, nr);
+	}
+	touch_wr(st.se, SE_CMD, (opcode << 27) | (params & 0x7ffffffu));
+	/* A truncated duplex read is larger than the TX FIFO, so keep feeding
+	 * it from the poll loop (Linux does the same from TX watermark IRQs). */
+	touch_fog_fill_tx(tx, nt, &sent, depth);
+
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = touch_irq();
+		touch_fog_fill_tx(tx, nt, &sent, depth);
+		if (irq & SE_ERRORS) {
+			err = EIO;
+			break;
+		}
+		if ((err = touch_fog_drain(rx, nr, &got)) != 0) {
+			break;
+		}
+		if (irq & SE_DONE) {
+			/* DONE may be visible before the last RX word lands. */
+			(void)touch_fog_drain(rx, nr, &got);
+			err = (touch_irq() & SE_ERRORS) ? EIO : 0;
+			if (!err && (got < nr || sent < words)) {
+				err = EIO;
+			}
+			touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+			if (!err) {
+				return 0;
+			}
+			break;
+		}
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST));
+		delay(1);
+	}
+	if (!err && (got < nr || sent < words)) {
+		err = EIO;
+	}
+	/* Probing retries the same read several times; keep the log readable. */
+	if (fog_logs++ < 6u) {
+		printf("SWEET TOUCH: fog spi op=%u frag=%u nt=%u nr=%u err=%d "
+		    "irq=%#x got=%u txw=%u/%u status=%#x\n", opcode, params >> 2,
+		    nt, nr, err, st.irq_last, got, sent, words,
+		    touch_rd(st.se, SE_STATUS));
+		touch_fog_dump();
+	}
+	touch_abort();
+	return err;
+}
+
+/* Novatek page register: 0xFF then bits 21:14 and 13:7 of the address. */
+static int
+touch_fog_set_page(uint32_t addr)
+{
+	uint8_t b[3];
+
+	b[0] = NVT_PAGE_CMD;
+	b[1] = (uint8_t)(addr >> 15);
+	b[2] = (uint8_t)(addr >> 7);
+	return touch_spi_run(SPI_TX_ONLY, 0, b, 3, NULL, 0);
+}
+
+/*
+ * CTP_SPI_READ() framing: the masked address byte, one dummy byte, then the
+ * payload - its rbuf copy starts at +2, not +1.  The vendor clocks that as a
+ * single duplex transfer; splitting it into TX then RX_ONLY is the fallback.
+ */
+static int
+touch_fog_read_duplex(uint32_t addr, uint8_t *buf, unsigned n)
+{
+	uint8_t tx[96], rx[96];
+	int err;
+
+	memset(tx, 0, sizeof(tx));
+	rx[0] = rx[1] = 0;
+	tx[0] = (uint8_t)(addr & 0x7fu);
+	if ((err = touch_spi_run(SPI_TX_RX, 0, tx, n + 2u, rx, n + 2u)) != 0) {
+		return err;
+	}
+	memcpy(buf, rx + 2, n);
+	return 0;
+}
+
+static int
+touch_fog_read_split(uint32_t addr, uint8_t *buf, unsigned n)
+{
+	uint8_t a = (uint8_t)(addr & 0x7fu);
+	uint8_t rx[96];
+	int err;
+
+	if ((err = touch_spi_run(SPI_TX_ONLY, SPI_FRAGMENT, &a, 1, NULL, 0)) != 0) {
+		return err;
+	}
+	if ((err = touch_spi_run(SPI_RX_ONLY, 0, NULL, 0, rx, n + 2u)) != 0) {
+		return err;
+	}
+	memcpy(buf, rx + 2, n);
+	return 0;
+}
+
+static int
+touch_fog_read(uint32_t addr, uint8_t *buf, unsigned n)
+{
+	int err;
+
+	if (n == 0 || n + 2u > 96u) {
+		return EINVAL;
+	}
+	if ((err = touch_fog_set_page(addr)) != 0) {
+		return err;
+	}
+	if (st.fog_read_mode < 0) {
+		err = touch_fog_read_duplex(addr, buf, n);
+		if (!err) {
+			st.fog_read_mode = 0;
+			printf("SWEET TOUCH: fog read mode=duplex\n");
+			return 0;
+		}
+		if (st.dead) {
+			return err;
+		}
+		err = touch_fog_read_split(addr, buf, n);
+		if (!err) {
+			st.fog_read_mode = 1;
+			printf("SWEET TOUCH: fog read mode=split\n");
+			return 0;
+		}
+		return err;
+	}
+	if (st.fog_read_mode == 0) {
+		return touch_fog_read_duplex(addr, buf, n);
+	}
+	return touch_fog_read_split(addr, buf, n);
+}
+
+/* Validate FWINFO at page+0x78 (fw_ver + ~fw_ver == 0xFF, sane panel). */
+static bool
+touch_fog_fwinfo(void)
+{
+	uint8_t buf[17];
+
+	for (unsigned i = 0; i < NVT_PAGE_COUNT; ++i) {
+		uint32_t page = fog_nvt_pages[i];
+		unsigned bx, by, lx, ly;
+
+		memset(buf, 0, sizeof(buf));
+		int err = touch_fog_read(page | NVT_EVENT_MAP_FWINFO, buf, sizeof(buf));
+		if (err) {
+			printf("SWEET TOUCH: fog fwinfo page=%#x err=%d\n", page, err);
+			if (st.dead) {
+				break;
+			}
+			continue;
+		}
+		bx = ((unsigned)buf[4] << 8) | buf[5];
+		by = ((unsigned)buf[6] << 8) | buf[7];
+		lx = ((unsigned)buf[5] << 8) | buf[4];
+		ly = ((unsigned)buf[7] << 8) | buf[6];
+		printf("SWEET TOUCH: fog fwinfo page=%#x fw=%02x/%02x xnum=%u "
+		    "ynum=%u be=%ux%u le=%ux%u\n", page, buf[0], buf[1], buf[2],
+		    buf[3], bx, by, lx, ly);
+		if ((unsigned)buf[0] + (unsigned)buf[1] != 0xffu) {
+			continue;
+		}
+		unsigned x = bx, y = by;
+		if (x < 200u || y <= x || y > 6000u) {
+			x = lx;
+			y = ly;
+		}
+		if (x < 200u || y <= x || y > 6000u) {
+			printf("SWEET TOUCH: fog fwinfo page=%#x dims implausible\n",
+			    page);
+			continue;
+		}
+		fog_nvt_page = page;
+		fog_abs_x = x;
+		fog_abs_y = y;
+		printf("SWEET TOUCH: fog novatek page=%#x fw-scale=%ux%u panel=%ux%u\n",
+		    page, x, y, FOG_PANEL_W, FOG_PANEL_H);
+		return true;
+	}
+	printf("SWEET TOUCH: fog fwinfo not confirmed; polling page=%#x\n",
+	    fog_nvt_page);
+	return false;
+}
+
+/* 65-byte EVENT_BUF frame: ten 6-byte records, id in bits 7:3, type 1/2=down. */
+static int
+touch_fog_report(void)
+{
+	uint8_t buf[NVT_POINT_DATA_LEN];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_fog_read(fog_nvt_page, buf, sizeof(buf));
+
+	if (err) {
+		return err;
+	}
+	if (!st.s_frames || buf[0] || buf[1]) {
+		memcpy(st.s_raw, buf, sizeof(st.s_raw));
+	}
+	st.s_frames++;
+	for (unsigned i = 0; i < NVT_MAX_TOUCH; ++i) {
+		const uint8_t *p = buf + 6u * i;
+		unsigned id = p[0] >> 3, type = p[0] & 7u, px, py;
+
+		if (id == 0 || id > NVT_MAX_TOUCH) {
+			continue;
+		}
+		if (type != 1u && type != 2u) {
+			continue; /* up / idle record */
+		}
+		px = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		py = ((unsigned)p[2] << 4) | (p[3] & 0x0fu);
+		if (fog_abs_x && fog_abs_x != FOG_PANEL_W) {
+			px = (unsigned)((uint64_t)px * FOG_PANEL_W / fog_abs_x);
+		}
+		if (fog_abs_y && fog_abs_y != FOG_PANEL_H) {
+			py = (unsigned)((uint64_t)py * FOG_PANEL_H / fog_abs_y);
+		}
+		if (px >= FOG_PANEL_W) {
+			px = FOG_PANEL_W - 1u;
+		}
+		if (py >= FOG_PANEL_H) {
+			py = FOG_PANEL_H - 1u;
+		}
+		mask |= 1u << (id - 1u);
+		x[id - 1u] = (int)px;
+		y[id - 1u] = (int)py;
+	}
+	unsigned n = (unsigned)__builtin_popcount(mask);
+	if (n > st.s_maxn) {
+		st.s_maxn = n;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static bool
+touch_fog_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	unsigned depth, width;
+
+	st.d_fw = fw;
+	st.d_status = touch_rd(st.se, SE_STATUS);
+	st.d_hwtx = tx;
+	st.d_hwrx = rx;
+	/* SE_HW_PARAM_1: RX FIFO width in bits (29:24), depth in words (21:16). */
+	depth = (rx >> 16) & 0x3fu;
+	width = (rx >> 24) & 0x3fu;
+	if (depth < 4u || depth > 16u) {
+		depth = 16u;
+	}
+	if (width < 8u || width > 64u) {
+		width = 32u;
+	}
+	st.fog_depth = depth;
+	st.fog_width = width;
+	printf("SWEET TOUCH: fog se0 fw=%#x proto=%u status=%#x tx=%#x rx=%#x "
+	    "ifdis=%#x depth=%u width=%u\n", fw, (fw >> 8) & 0xffu,
+	    touch_rd(st.se, SE_STATUS), tx, rx, touch_rd(st.se, 0x64), depth,
+	    width);
+	if (((fw >> 8) & 0xffu) != 1u) {
+		printf("SWEET TOUCH: SE0 has no GENI SPI firmware; probes skipped\n");
+		return false;
+	}
+	/* GENI_IF_DISABLE_RO bit 0 is not a failure: it says the SE was
+	 * configured for GPI DMA (spi-geni-qcom takes the same bit as "prefer
+	 * GPI" and still falls back to FIFO without a GPI channel). Clearing
+	 * SE_GENI_DMA_MODE_EN below selects the FIFO interface we have. */
+	if (touch_rd(st.se, 0x64) & 1u) {
+		printf("SWEET TOUCH: SE0 gpi-preferred (ifdis=1); using FIFO mode\n");
+	}
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET TOUCH: SE0 already busy; probes skipped\n");
+		return false;
+	}
+	touch_wr(st.se, SE_GENI_GSI_EVENT_EN, 0); /* no GSI events */
+	touch_wr(st.se, SE_GENI_IRQ_EN, 0x4u);    /* GENI_M_IRQ_EN, polled */
+	touch_wr(st.se, SE_GENI_S_IRQ_EN, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_GENI_S_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);               /* FIFO mode */
+	touch_wr(st.se, SE_GENI_CGC_CTRL, touch_rd(st.se, SE_GENI_CGC_CTRL) | 0x7fu);
+	touch_wr(st.se, SE_GENI_DMA_GENERAL_CFG,
+	    touch_rd(st.se, SE_GENI_DMA_GENERAL_CFG) | 0x0fu);
+	touch_wr(st.se, SE_GENI_OUTPUT_CTRL, 0x7f);
+	touch_wr(st.se, SE_GENI_FORCE_DEFAULT, 1);
+	touch_wr(st.se, SE_CLK_SEL, 0);
+	/* gcc parent is 19.2 MHz; the SPI core clock divides by 2 = 9.6 MHz. */
+	touch_wr(st.se, SE_MCLK, (2u << 4) | 1u);
+	touch_wr(st.se, SE_SPI_CPHA, 0);
+	touch_wr(st.se, SE_SPI_CPOL, 0);
+	touch_wr(st.se, SE_SPI_DEMUX_INV, 0);
+	touch_wr(st.se, SE_SPI_DEMUX_SEL, 0);
+	touch_wr(st.se, SE_SPI_TRANS_CFG,
+	    touch_rd(st.se, SE_SPI_TRANS_CFG) & ~SE_SPI_CS_TOGGLE);
+	touch_wr(st.se, SE_SPI_WORD_LEN, 4u); /* bits_per_word - 4 */
+	touch_wr(st.se, SE_GENI_BYTE_GRAN, 0); /* four 8-bit words per FIFO entry */
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	/* Linux geni_se_init(): rx_wm = depth-3, RFR = depth-2.  Leaving both
+	 * at 0 leaves the RX side unable to start streaming. */
+	touch_wr(st.se, SE_RX_WM, depth > 3u ? depth - 3u : 1u);
+	touch_wr(st.se, SE_RFR_WM, depth > 2u ? depth - 2u : 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	printf("SWEET TOUCH: fog spi mclk=%#x wordlen=%#x trans=%#x pack=%#x/%#x "
+	    "gran=%#x rwm=%#x rfr=%#x\n", touch_rd(st.se, SE_MCLK),
+	    touch_rd(st.se, SE_SPI_WORD_LEN), touch_rd(st.se, SE_SPI_TRANS_CFG),
+	    touch_rd(st.se, 0x260), touch_rd(st.se, 0x264),
+	    touch_rd(st.se, SE_GENI_BYTE_GRAN), touch_rd(st.se, SE_RX_WM),
+	    touch_rd(st.se, SE_RFR_WM));
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+	    touch_rd(st.se, SE_GENI_BYTE_GRAN) != 0) {
+		printf("SWEET TOUCH: fog packing readback mismatch; probes skipped\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET TOUCH: fog inherited FIFO data; probes skipped\n");
+		return false;
+	}
+	return true;
+}
+
+/* Internal MOSI->MISO loopback: proves the RX FIFO/opcode path without the
+ * panel.  Four duplex bytes must come back verbatim. */
+static void
+touch_fog_loopback(void)
+{
+	static const uint8_t pat[4] = { 0xa5u, 0x5au, 0x3cu, 0xc3u };
+	uint8_t rx[8];
+
+	memset(rx, 0, sizeof(rx));
+	touch_wr(st.se, SE_SPI_LOOPBACK, 1);
+	int err = touch_spi_run(SPI_TX_RX, 0, pat, 4, rx, 4);
+	touch_wr(st.se, SE_SPI_LOOPBACK, 0);
+	printf("SWEET TOUCH: fog loopback err=%d rx=%02x %02x %02x %02x ios=%#x\n",
+	    err, rx[0], rx[1], rx[2], rx[3], touch_rd(st.se, SE_IOS));
+}
+
+/* Whole fog bring-up: clocks, SE0, pins, reset, FWINFO probe, poll loop. */
+static void
+touch_fog_run(void)
+{
+	st.stage = "fog clocks";
+	if (!touch_clocks()) {
+		return;
+	}
+	st.fog_read_mode = -1;
+	st.stage = "fog se0";
+	if (!touch_fog_se_init()) {
+		return;
+	}
+	/* Run the internal loopback before the SPI pins are muxed to the QUP:
+	 * its pattern must never reach the panel. */
+	touch_fog_loopback();
+	if (st.dead) {
+		return;
+	}
+	st.stage = "fog pins";
+	for (unsigned pin = 0; pin < FOG_SPI_PINS; ++pin) {
+		touch_gpio(pin, 1, 0, 2, false, false); /* qup0, 6 mA, no pull */
+	}
+	touch_gpio(FOG_PIN_IRQ, 0, 3, 3, false, false);  /* input, pull-up, 8 mA */
+	touch_gpio(FOG_PIN_RESET, 0, 3, 3, true, true);  /* output, pull-up, idle high */
+	touch_wait(10);
+	printf("SWEET TOUCH: fog pins sck=%#x mosi=%#x miso=%#x cs=%#x irq=%#x/%#x "
+	    "reset=%#x/%#x\n",
+	    touch_rd(st.west, TOUCH_GPIO_CFG(0)), touch_rd(st.west, TOUCH_GPIO_CFG(1)),
+	    touch_rd(st.west, TOUCH_GPIO_CFG(2)), touch_rd(st.west, TOUCH_GPIO_CFG(3)),
+	    touch_rd(st.west, TOUCH_GPIO_CFG(FOG_PIN_IRQ)),
+	    touch_rd(st.west, TOUCH_GPIO_IO(FOG_PIN_IRQ)),
+	    touch_rd(st.west, TOUCH_GPIO_CFG(FOG_PIN_RESET)),
+	    touch_rd(st.west, TOUCH_GPIO_IO(FOG_PIN_RESET)));
+	/* Novatek power-on reset is active low; firmware is up after ~200 ms. */
+	touch_gpio(FOG_PIN_RESET, 0, 0, 3, true, false);
+	touch_wait(20);
+	touch_gpio(FOG_PIN_RESET, 0, 0, 3, true, true);
+	touch_wait(250);
+	st.stage = "fog probe";
+	st.probing = true;
+	(void)touch_fog_fwinfo();
+	st.probing = false;
+	if (st.dead) {
+		return;
+	}
+	st.stage = "fog polling";
+	printf("SWEET TOUCH: fog novatek polling page=%#x poll=10ms irq-hint=%d\n",
+	    fog_nvt_page, st.irq_hint);
+	unsigned errors = 0, ticks = 0, polls = 0;
+	while (!st.dead) {
+		if (st.diag == 3 && ++polls % 500u == 0) {
+			printf("SWEET TOUCH: fog frames=%u errors=%u down=%u up=%u "
+			    "last=%d,%d active=%#x\n", st.s_frames, st.s_errs,
+			    st.s_down, st.s_up, st.s_lastx, st.s_lasty, st.active);
+		}
+		if (st.diag == 2 && ++polls == 3000) {
+			panic("SWEET TOUCH fog stats: frames=%u errs=%u lasterr=%d "
+			    "maxn=%u hid down=%u up=%u last=%d,%d | raw %02x %02x "
+			    "%02x | %02x %02x %02x %02x %02x %02x", st.s_frames,
+			    st.s_errs, st.s_lasterr, st.s_maxn, st.s_down, st.s_up,
+			    st.s_lastx, st.s_lasty, st.s_raw[0], st.s_raw[1],
+			    st.s_raw[2], st.s_raw[3], st.s_raw[4], st.s_raw[5],
+			    st.s_raw[6], st.s_raw[7], st.s_raw[8]);
+		}
+		if (!st.irq_hint || st.active ||
+		    !(touch_rd(st.west, TOUCH_GPIO_IO(FOG_PIN_IRQ)) & 1u) ||
+		    (++ticks % 10u) == 0) {
+			int err = touch_fog_report();
+			if (err) {
+				st.s_errs++;
+				st.s_lasterr = err;
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET TOUCH: fog report err=%d irq=%#x\n",
+					    err, st.irq_status);
+				}
+				if (errors == 10) {
+					touch_report(0, st.x, st.y);
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		touch_wait(10);
+	}
+	touch_report(0, st.x, st.y);
+}
