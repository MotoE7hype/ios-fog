+/*
+ * Scaled present: the logical display (fLogicalW x fLogicalH, what userland
+ * renders into and GetDisplaySize reports) is resampled onto the panel
+ * (fWidth x fHeight). Only reached when the panel is smaller in some axis.
+ *
+ * Point-sampled, integer 16.16 mapping, per-pixel alpha, no SIMD. Fit
+ * letterboxes the result in black; fill crops the overflow.
+ */
+void
+AppleCLCD::presentScaled(const uint8_t *rec, uint32_t mask)
+{
+	/* Fit leaves letterbox bars, fill crops: both start from black. */
+	for (uint32_t y = 0; y < fHeight; y++) {
+		bzero((void *)(fPixels + (uint64_t)y * fRowBytes), (size_t)fWidth * 4);
+	}
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		if (!(mask & (1u << layer))) {
+			continue;
+		}
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		int32_t w = (int32_t)get32(rec, 0xc4 + 16 * layer + 8);
+		int32_t h = (int32_t)get32(rec, 0xc4 + 16 * layer + 12);
+		if (id == 0 || w <= 0 || h <= 0) {
+			continue;
+		}
+		presentLayer(rec, layer);
+	}
+}
+
+/*
+ * One layer: clip the logical destination rect to the logical display, map
+ * it through the same scale as the whole frame, and blend it into the panel.
+ */
+void
+AppleCLCD::presentLayer(const uint8_t *rec, uint32_t layer)
+{
+	const uint8_t *a = rec + 0x64 + 16 * layer;
+	const uint8_t *b = rec + 0xc4 + 16 * layer;
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+	int32_t lx = (int32_t)get32(b, 0), ly = (int32_t)get32(b, 4);
+	int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+	SweetSurface *s;
+	uint64_t scale, mw, mh, pw, ph, offx, offy;
+	uint32_t dw, dh, dx, dy;
+
+	s = sweet_surface_copy(get32(rec, 0x54 + 4 * layer));
+	if (s == NULL || s == fSurface || s->memory == NULL) {
+		OSSafeReleaseNULL(s);
+		return;
+	}
+	if ((s->bytesPerElement ? s->bytesPerElement : 4) != 4 ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || s->bytesPerRow == 0) {
+		s->release();           /* unsupported layout: leave it alone */
+		return;
+	}
+	if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	if (sx < 0 || sy < 0) {
+		sx = sy = 0;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	/* Clip the logical rect to the logical display. */
+	if (lx < 0) {
+		sx -= lx;
+		w += lx;
+		lx = 0;
+	}
+	if (ly < 0) {
+		sy -= ly;
+		h += ly;
+		ly = 0;
+	}
+	if (lx + w > (int32_t)fLogicalW) {
+		w = (int32_t)fLogicalW - lx;
+	}
+	if (ly + h > (int32_t)fLogicalH) {
+		h = (int32_t)fLogicalH - ly;
+	}
+	if (w <= 0 || h <= 0) {
+		s->release();
+		return;
+	}
+
+	/* Logical -> panel, 16.16 fixed point so 1125 -> 720 keeps accuracy. */
+	mw = ((uint64_t)fWidth << 16) / fLogicalW;
+	mh = ((uint64_t)fHeight << 16) / fLogicalH;
+	scale = fScaleMode == 2 ? (mw > mh ? mw : mh) : (mw < mh ? mw : mh);
+	pw = ((uint64_t)fLogicalW * scale) >> 16;
+	ph = ((uint64_t)fLogicalH * scale) >> 16;
+	offx = pw < fWidth ? (fWidth - pw) / 2 : 0;
+	offy = ph < fHeight ? (fHeight - ph) / 2 : 0;
+	dw = (uint32_t)(((uint64_t)w * scale) >> 16);
+	dh = (uint32_t)(((uint64_t)h * scale) >> 16);
+	dx = (uint32_t)(offx + (((uint64_t)lx * scale) >> 16));
+	dy = (uint32_t)(offy + (((uint64_t)ly * scale) >> 16));
+	if (dw == 0 || dh == 0 || dx >= fWidth || dy >= fHeight) {
+		s->release();
+		return;
+	}
+	if (dx + dw > fWidth) {
+		dw = fWidth - dx;
+	}
+	if (dy + dh > fHeight) {
+		dh = fHeight - dy;
+	}
+
+	blend((uint32_t *)(fPixels + (uint64_t)dy * fRowBytes + (uint64_t)dx * 4),
+	    dw, dh, (const uint32_t *)s->kernelAddress(), (uint32_t)sx, (uint32_t)sy,
+	    (uint32_t)w, (uint32_t)h, s->bytesPerRow / 4, s->width, s->height);
+	s->release();
+}
+
+/*
+ * Point-sampled box resample with per-pixel alpha, so a translucent layer
+ * still composites over whatever the destination already holds.
+ */
+void
+AppleCLCD::blend(uint32_t *dst, uint32_t dw, uint32_t dh, const uint32_t *src,
+    uint32_t sx, uint32_t sy, uint32_t sw, uint32_t sh,
+    uint32_t srcStride, uint32_t swid, uint32_t shei)
+{
+	uint32_t dstStride = fRowBytes / 4;
+	uint32_t fixedX = ((sw << 16) / dw) + 1;
+	uint32_t fixedY = ((sh << 16) / dh) + 1;
+
+	for (uint32_t y = 0; y < dh; y++) {
+		uint32_t srcY = sy + (uint32_t)(((uint64_t)y * fixedY) >> 16);
+		uint32_t *drow = dst + (uint64_t)y * dstStride;
+		const uint32_t *srow;
+
+		if (srcY >= shei) {
+			srcY = shei - 1;
+		}
+		srow = src + (uint64_t)srcY * srcStride;
+		for (uint32_t x = 0; x < dw; x++) {
+			uint32_t srcX = sx + (uint32_t)(((uint64_t)x * fixedX) >> 16);
+			uint32_t p, alpha, d, ia, rb, ag;
+
+			if (srcX >= swid) {
+				srcX = swid - 1;
+			}
+			p = srow[srcX];
+			alpha = p >> 24;
+			if (alpha == 0xff) {
+				drow[x] = p;
+			} else if (alpha != 0) {
+				d = drow[x];
+				ia = 255 - alpha;
+				rb = (((p & 0x00ff00ff) * alpha) +
+				    ((d & 0x00ff00ff) * ia)) >> 8;
+				ag = ((((p >> 8) & 0x00ff00ff) * alpha) +
+				    (((d >> 8) & 0x00ff00ff) * ia)) >> 8;
+				drow[x] = (rb & 0x00ff00ff) | ((ag & 0x00ff00ff) << 8) |
+				    0xff000000;
+			}
+		}
+	}
+}
